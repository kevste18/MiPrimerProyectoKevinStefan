<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="561dp"
        android:layout_height="509dp"
        tools:layout_editor_absoluteX="187dp"
        tools:layout_editor_absoluteY="280dp" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="320dp"
        android:layout_height="247dp"
        tools:layout_editor_absoluteX="45dp"
        tools:layout_editor_absoluteY="847dp"
        tools:srcCompat="@tools:sample/avatars" />

    <TextClock
        android:id="@+id/textClock"
        android:layout_width="299dp"
        android:layout_height="103dp"
        tools:layout_editor_absoluteX="442dp"
        tools:layout_editor_absoluteY="825dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="223dp"
        android:layout_height="119dp"
        tools:layout_editor_absoluteX="492dp"
        tools:layout_editor_absoluteY="959dp" />

</androidx.constraintlayout.widget.ConstraintLayout>